# Copy to .env (gitignored) in the folder you run `modelmapper` from, or export these in your shell.
# Real environment variables win over .env. `modelmapper settings` shows what each resolves to (never key values).

# ---- Model -------------------------------------------------------------------------------------------------------
# Hugging Face id of the model to map. Default: Qwen/Qwen3-8B. Any decoder with gated (SwiGLU-style) MLPs laid out as
# model.model.layers[i].mlp.{gate_proj,up_proj,down_proj} should work (Qwen, Llama, Mistral, ...); only Qwen3 is tested.
MODEL_MAPPER_MODEL=
# Folder of local model copies, one subfolder per model (<dir>/Qwen3-8B/config.json). Default: the Hugging Face cache.
MODEL_MAPPER_MODELS=
# cuda, cuda:1, mps or cpu. Default: CUDA if available, else Apple MPS, else CPU.
MODEL_MAPPER_DEVICE=
# bfloat16 (default; every published run), float16 or float32 (much faster than bfloat16 on most CPUs)
MODEL_MAPPER_DTYPE=
# Where downloads (the published map for `lookup`) and built range tables go. Default: ~/.cache/modelmapper
MODEL_MAPPER_CACHE=
# A FineWeb parquet shard, only for `modelmapper ranges` (Qwen3-0.6B and Qwen3-8B ship with their tables).
MODEL_MAPPER_CORPUS=
# The published map that `modelmapper lookup` reads. Default: the Qwen Neuron Map.
MODEL_MAPPER_MAP_URL=

# ---- Labeller (writes and judges the questions for map-concept) ------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint that supports response_format json_object.
OPENAI_BASE_URL=
# Default gpt-6-luna (every published map). Another model gives different questions, so different maps.
OAI_MODEL=
# Or a file holding just the key: OAI_KEY_FILE=<path> (default ./OAI.env). Empty for a self-hosted endpoint.
OPENAI_API_KEY=
OAI_KEY_FILE=
# (MODEL_MAPPER_DOTENV=<path>, set in the environment, reads a different file instead of this .env.)

# ---- Judge (optional; only for `steer --judge`) -----------------------------------------------------------------------
# "jev" (default; TypeSafe's Jev, used for the published steering results) or "llm" (any OpenAI-compatible endpoint
# that returns top_logprobs; not calibrated against Jev).
JUDGE_BACKEND=
# jev backend (TYPESAFE_API_KEY also works; or JEV_KEY_FILE=<path>, default ./jevkey.env)
JEV_API_KEY=
JEV_KEY_FILE=
# llm backend
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
# e.g. {"chat_template_kwargs": {"enable_thinking": false}} for a local Qwen3 behind vLLM / llama.cpp
JUDGE_EXTRA_BODY=
# $ per million input tokens, for the cost tally (default 0)
JUDGE_USD_PER_MTOK=

# ---- Method (change only to study the method itself; METHOD.md) -----------------------------------------------------
# A question counts as recalled when P(answer) >= this. Default 0.2.
CONCEPT_MIN_P=
# How questions are put to the model: chat (default; every published map) or plain ("Question: ..." / "Answer:", for
# base models without a chat template; experimental, uncalibrated; recorded in each record).
MODEL_MAPPER_PROMPT=
