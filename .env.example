# Copy to .env (gitignored) or export these in your shell. Real environment variables win over .env.

# Folder of local model copies, one subfolder per model (<dir>/Qwen3-8B/config.json).
# Default: <repo>/models. Models not found here are loaded from the Hugging Face hub.
ALREADY_CLEAN_MODELS=

# FineWeb parquet shard used to build the activation atlas and scans.
# Default: <repo>/data/fineweb_000_00000.parquet
ALREADY_CLEAN_CORPUS=

# OpenAI key for the "Luna" neuron-explanation labeller (src/oai.py). Fallback file: OAI.env
OPENAI_API_KEY=
# Model id used by src/oai.py (default gpt-6-luna)
OAI_MODEL=

# TypeSafe Jev key for the probability judge (src/jev.py). TYPESAFE_API_KEY also works. Fallback file: jevkey.env
JEV_API_KEY=
