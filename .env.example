# Copy to .env (gitignored) or export these in your shell. Real environment variables win over .env.

# ---- Model under study and local files ---------------------------------------------------------------
# Hugging Face id of the model to map. Default: Qwen/Qwen3-8B. Any decoder with gated (SwiGLU-style) MLPs
# laid out as model.model.layers[i].mlp.{gate_proj,up_proj,down_proj} works (Qwen, Llama, Mistral, ...).
MODEL_MAPPER_MODEL=
# Folder of local model copies, one subfolder per model (<dir>/Qwen3-8B/config.json).
# Default: <repo>/models. Models not found here are loaded from the Hugging Face hub.
MODEL_MAPPER_MODELS=
# Device: cuda, cuda:1, mps or cpu. Default: CUDA if available, else Apple MPS, else CPU.
MODEL_MAPPER_DEVICE=
# Weights dtype: bfloat16 (default; every reported run), float16 or float32 (much faster than bf16 on most CPUs)
MODEL_MAPPER_DTYPE=
# Batch sizes. Lower them on small GPUs; they change speed and memory, not what is computed.
# Tokens per forward pass when building the atlas (default 6144):
MODEL_MAPPER_ATLAS_BATCH=
# Replies generated per batch in the steering grids (default 100):
MODEL_MAPPER_GEN_BATCH=
# FineWeb parquet shard used for the atlas, scans and random-snippet controls (scripts/download_corpus.sh).
# Default: <repo>/data/fineweb_000_00000.parquet
MODEL_MAPPER_CORPUS=

# ---- Labeller LLM (src/oai.py): writes neuron explanations and recall prompts --------------------------
# Any OpenAI-compatible chat-completions endpoint; must support response_format json_object.
OPENAI_BASE_URL=
OAI_MODEL=
# Fallback file: OAI.env. Leave empty for a self-hosted endpoint without auth.
OPENAI_API_KEY=

# ---- Judge (src/jev.py): calibrated yes/no, choice and rubric probabilities ----------------------------
# "jev" (default; TypeSafe's Jev, used for every result in this repo) or "llm" (any OpenAI-compatible
# endpoint that returns top_logprobs; uncalibrated relative to Jev, so re-run the controls).
JUDGE_BACKEND=
# jev backend. TYPESAFE_API_KEY also works. Fallback file: jevkey.env
JEV_API_KEY=
# llm backend
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
# e.g. {"chat_template_kwargs": {"enable_thinking": false}} for a local Qwen3 behind vLLM / llama.cpp
JUDGE_EXTRA_BODY=
# $ per million input tokens, for the cost tallies (default 0)
JUDGE_USD_PER_MTOK=
